        "import numpy as np\n",
        "\n",
        "# House data: Bedrooms, Square Footage, Sale Price\n",
        "house_data = np.array([\n",
        "    [3, 1500, 200000],\n",
        "    [5, 2500, 350000],\n",
        "    [4, 2000, 280000],\n",
        "    [6, 3000, 450000],\n",
        "    [5, 2700, 400000]\n",
        "])\n",
        "\n",
        "# Find houses with more than 4 bedrooms\n",
        "filtered_houses = house_data[house_data[:, 0] > 4]\n",
        "\n",
        "# Calculate average sale price\n",
        "average_price = np.mean(filtered_houses[:, 2])\n",
        "\n",
        "# Display the result\n",
        "print(\"Average sale price:\", average_price)"
      ]
