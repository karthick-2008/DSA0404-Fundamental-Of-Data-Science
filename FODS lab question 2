        "    [250, 300, 350],\n",
        "    [120, 180, 240]\n",
        "])\n",
        "\n",
        "# Calculate the average price of all products sold\n",
        "average_price = np.mean(sales_data)\n",
        "\n",
        "# Display the result\n",
        "print(\"Average price of all products:\", average_price)"
