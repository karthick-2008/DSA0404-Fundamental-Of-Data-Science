      "source": [
        "import numpy as np\n",
        "\n",
        "house_data = np.array([\n",
        "    [3, 1200, 200000],\n",
        "    [5, 1800, 350000],\n",
        "    [4, 1500, 280000],\n",
        "    [6, 2200, 450000],\n",
        "    [5, 2000, 400000]\n",
        "])\n",
        "\n",
        "bedrooms = house_data[:, 0]\n",
        "sale_price = house_data[:, 2]\n",
        "\n",
        "filtered_prices = sale_price[bedrooms > 4]\n",
        "\n",
        "average_price = np.mean(filtered_prices)\n",
        "\n",
        "print(\"Average sale price of houses with more than 4 bedrooms:\", average_price)"
      ]
