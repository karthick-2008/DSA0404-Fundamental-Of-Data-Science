      "source": [
        "from heapq import heappush, heappop\n",
        "\n",
        "goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)\n",
        "\n",
        "def heuristic(state):\n",
        "    return sum(\n",
        "        state[i] != 0 and state[i] != goal[i]\n",
        "        for i in range(9)\n",
        "    )\n",
        "\n",
        "def solve(start):\n",
        "    pq = []\n",
        "    heappush(pq, (heuristic(start), 0, start, []))\n",
        "    visited = set()\n",
        "\n",
        "    while pq:\n",
        "        f, g, state, path = heappop(pq)\n",
        "\n",
        "        if state == goal:\n",
        "            return path + [state]\n",
        "\n",
        "        if state in visited:\n",
        "            continue\n",
        "        visited.add(state)\n",
        "\n",
        "        zero = state.index(0)\n",
        "        moves = []\n",
        "\n",
        "        if zero >= 3:\n",
        "            moves.append(zero - 3)\n",
        "        if zero < 6:\n",
        "            moves.append(zero + 3)\n",
        "        if zero % 3 != 0:\n",
        "            moves.append(zero - 1)\n",
        "        if zero % 3 != 2:\n",
        "            moves.append(zero + 1)\n",
        "\n",
        "        for move in moves:\n",
        "            new_state = list(state)\n",
        "            new_state[zero], new_state[move] = (\n",
        "                new_state[move], new_state[zero]\n",
        "            )\n",
        "            new_state = tuple(new_state)\n",
        "\n",
        "            if new_state not in visited:\n",
        "                heappush(\n",
        "                    pq,\n",
        "                    (g + 1 + heuristic(new_state),\n",
        "                     g + 1, new_state, path + [state])\n",
        "                )\n",
        "\n",
        "    return None\n",
        "\n",
        "start = (1, 2, 3, 4, 0, 6, 7, 5, 8)\n",
        "solution = solve(start)\n",
        "\n",
        "if solution:\n",
        "    for state in solution:\n",
        "        for i in range(0, 9, 3):\n",
        "            print(state[i:i + 3])\n",
        "        print()\n",
        "else:\n",
        "    print(\"No solution found\")"
      ]
