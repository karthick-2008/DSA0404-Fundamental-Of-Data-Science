        "from google.colab import files\n",
        "uploaded = files.upload()\n",
        "import pandas as pd\n",
        "\n",
        "# Read dataset\n",
        "df = pd.read_excel(\"Exp8.xlsx\")\n",
        "\n",
        "# Convert order date into datetime format\n",
        "df[\"order_date\"] = pd.to_datetime(df[\"order_date\"])\n",
        "\n",
        "# 1. Total number of orders made by each customer\n",
        "customer_orders = df.groupby(\"customer_name\")[\"order_id\"].nunique()\n",
        "\n",
        "print(\"Total Orders Made by Each Customer:\")\n",
        "print(customer_orders.head(10))\n",
        "\n",
        "# 2. Average order quantity for each product\n",
        "average_quantity = df.groupby(\"product_name\")[\"quantity\"].mean()\n",
        "\n",
        "print(\"\\nAverage Order Quantity for Each Product:\")\n",
        "print(average_quantity.head(10))\n",
        "\n",
        "# 3. Earliest and latest order dates\n",
        "earliest_date = df[\"order_date\"].min()\n",
        "latest_date = df[\"order_date\"].max()\n",
        "\n",
        "print(\"\\nEarliest Order Date:\", earliest_date)\n",
        "print(\"Latest Order Date:\", latest_date)\n"
